{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 0,

    "modules-left": [
        "hyprland/workspaces",
        "clock",
        "group/system",
        "custom/cava"
    ],
    "modules-center": [
        "hyprland/window"
    ],
    "modules-right": [
        "mpris",
        "custom/updates",
        "tray",
        "group/toggles",
        "group/connectivity",
        "group/levels",
        "battery",
        "custom/power"
    ],

    "group/system": {
        "orientation": "horizontal",
        "modules": ["cpu", "memory", "temperature", "power-profiles-daemon"]
    },

    "group/connectivity": {
        "orientation": "horizontal",
        "modules": ["network", "bluetooth"]
    },

    "group/levels": {
        "orientation": "horizontal",
        "modules": ["wireplumber", "backlight"]
    },

    "group/toggles": {
        "orientation": "horizontal",
        "modules": ["idle_inhibitor", "custom/nightlight", "custom/dnd"]
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": { "activated": "󰅶", "deactivated": "󰾪" },
        "tooltip-format-activated": "Staying awake (no auto lock / suspend)",
        "tooltip-format-deactivated": "Auto lock / suspend enabled"
    },

    "custom/nightlight": {
        "exec": "~/.config/waybar/scripts/nightlight.sh",
        "return-type": "json",
        "interval": 60,
        "signal": 8,
        "on-click": "~/.config/waybar/scripts/nightlight.sh toggle"
    },

    "custom/dnd": {
        "exec": "~/.config/waybar/scripts/dnd.sh",
        "return-type": "json",
        "interval": 30,
        "signal": 9,
        "on-click": "~/.config/waybar/scripts/dnd.sh toggle"
    },

    "custom/updates": {
        "exec": "~/.config/waybar/scripts/updates.sh",
        "exec-if": "command -v checkupdates",
        "return-type": "json",
        "interval": 1800,
        "on-click": "kitty --title 'System update' sh -c 'yay -Syu; echo; read -p \"Done, press Enter to close\" _'; pkill -RTMIN+10 waybar",
        "signal": 10
    },

    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "tooltip-format": "Brightness: {percent}%",
        "on-scroll-up": "brightnessctl -e4 -n2 set 5%+; quickshell -c shell ipc call osd brightness",
        "on-scroll-down": "brightnessctl -e4 -n2 set 5%-; quickshell -c shell ipc call osd brightness"
    },

    "power-profiles-daemon": {
        "format": "{icon}",
        "format-icons": {
            "default": "󰾅",
            "performance": "󰓅",
            "balanced": "󰾅",
            "power-saver": "󰾆"
        },
        "tooltip-format": "Power profile: {profile}\nClick to switch"
    },
    "custom/cava": {
        "exec": "~/.config/waybar/scripts/cava.sh",
        "exec-if": "pgrep -x spotify",
        "restart-interval": 5,
        "tooltip": false
    },
    "hyprland/workspaces": {
        "all-outputs": true,
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true
    },

    "cpu": {
        "interval": 5,
        "format": " {usage}%", 
        "tooltip-format": "CPU: {usage}%\n{avg_frequency} GHz"
    },

    "memory": {
        "interval": 5,
        "format": " {percentage}%",
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G\nSwap: {swapUsed:0.1f}G / {swapTotal:0.1f}G"
    },

    "temperature": {
        "interval": 5,
        "thermal-zone": 0,
        "critical-threshold": 80,
        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C",
        "tooltip-format": "Temperature: {temperatureC}°C"
    },
    "mpris": {
        "format": "{status_icon}  {dynamic}",
        "interval": 1,
        "dynamic-len": 28,
        "status-icons": {
            "playing": "▶",
            "paused": "⏸",
            "stopped": ""
        },
        "dynamic-order": ["title", "artist"],
        "tooltip-format": "{title} - {artist}\n{album}\n{position}/{length}"
    },
    "clock": {
        "format": "{:%H:%M · %a %d %b}",
        "tooltip-format": "<big>{:%A %d %B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "network": {
        "interval": 5,
        "format-wifi": "{icon}",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "format-ethernet": "󰈀  {ifname}",
        "format-disconnected": "󰤭",
        "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%\nFrequency: {frequency} GHz\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
        "tooltip-format-ethernet": "Interface: {ifname}\nIP: {ipaddr}/{cidr}\nGateway: {gwaddr}",
        "tooltip-format-disconnected": "No connection",
        "on-click": "~/.config/waybar/scripts/wifi-menu.sh"
    },

    "bluetooth": {
        "format": "󰂯",
        "format-disabled": "󰂲",
        "format-off": "󰂲",
        "format-connected": "󰂱 {device_alias}",
        "format-connected-battery": "󰂱 {device_alias} {device_battery_percentage}%",
        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "tooltip-format-connected": "{controller_alias}\n{num_connections} connected\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "tooltip-format-enumerate-connected-battery": "{device_alias} {device_battery_percentage}%",
        "on-click": "blueman-manager",
        "on-click-right": "bluetoothctl power $(bluetoothctl show | grep -q 'Powered: yes' && echo off || echo on)"
    },

    "battery": {
        "interval": 10,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰚥 {capacity}%",
        "format-plugged": "󱐥 {capacity}%",
        "format-icons": ["󰂎", "󰁺","󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "Battery: {capacity}%\nPower: {power:.1f}W\nTime: {time}"
    },

    "wireplumber": {
        "scroll-step": 5,
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 Muted",
        "format-icons": ["󰕿", "󰖀","󰕾"],
        "tooltip-format": "Volume: {volume}%\nNode: {node_name}",
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },

    "tray": {
        "icon-size": 18,
        "spacing": 8
    },

    "custom/power": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.config/waybar/scripts/power-menu.sh"
    },
    "hyprland/window": {
        "format": "{}",
        "separate-outputs": true,
        "max-length": 40
    }
}
