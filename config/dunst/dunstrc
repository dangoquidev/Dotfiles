[global]
    follow = mouse

    width = 300
    height = (0, 100)
    offset = (10, 50)
    origin = top-right
    transparency = 10
   
    frame_width = 2
    frame_color = "#ff8fa3"
    
    font = Maple Mono NF CN 10

    padding = 8
    horizontal_padding = 8
    text_icon_padding = 0
    icon_position = left
    max_icon_size = 48
    enable_recursive_icon_lookup = true
    icon_theme = Adwaita

[urgency_low]
    background = "#1a1b26"
    foreground = "#e0def4"
    frame_color = "#FFD1DC"
    timeout = 10

[urgency_normal]
    background = "#1a1b26"
    foreground = "#e0def4"
    frame_color = "#FFD1DC"
    timeout = 10

[urgency_critical]
    background = "#1a1b26"
    foreground = "#f7768e"
    frame_color = "#f7768e"
    timeout = 0
